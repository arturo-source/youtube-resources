# ✅ TIP 5: lo mismo en Nginx (referencia; no se usa en la demo)
# Brotli necesita el módulo ngx_brotli (en muchas distros: libnginx-mod-brotli).
server {
    listen 8080;
    root /ruta/a/05-compresion-cache/dist;

    # Servir los .br / .gz generados por build.mjs
    brotli_static on;
    gzip_static on;

    # Compresión al vuelo para lo demás
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    brotli on;
    brotli_types text/css application/javascript application/json image/svg+xml;

    location ~* "\.[0-9a-f]{8}\.[a-z0-9]+$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location /api/ {
        add_header Cache-Control "public, max-age=60, stale-while-revalidate=600";
    }
    location /img/products/ {
        add_header Cache-Control "public, max-age=604800";
    }
}
