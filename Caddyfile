# Sirve todos los pasos a la vez, cada uno en su puerto:
#   caddy run            (desde la raíz del proyecto)
#
#   http://localhost:8000  → 00 inicial
#   http://localhost:8001  → 01 lazy loading y code splitting
#   http://localhost:8002  → 02 optimización de imágenes
#   http://localhost:8003  → 03 evitar bloquear el renderizado
#   http://localhost:8004  → 04 reducir peticiones de red
#   http://localhost:8005  → 05 compresión y caché   (requiere `node build.mjs`)
#   http://localhost:8006  → 06 bonus: medición       (requiere `node build.mjs`)
#
# Los pasos 00–04 usan un file_server sin compresión y sin política de caché.
# OJO: por defecto, sin Cache-Control el navegador "adivina" (frescura heurística:
# 10 % del tiempo desde Last-Modified) y no pregunta al servidor. Para que la
# demo sea repetible, 00–04 llevan `Cache-Control: no-cache` (= revalidar siempre
# con ETag → 304). Los pasos 05–06 usan la política optimizada.
{
	admin off
}

:8000 {
	root * 00-inicial
	header Cache-Control "no-cache"
	file_server
}

:8001 {
	root * 01-lazy-loading-code-splitting
	header Cache-Control "no-cache"
	file_server
}

:8002 {
	root * 02-optimizacion-imagenes
	header Cache-Control "no-cache"
	file_server
}

:8003 {
	root * 03-evitar-bloqueo-render
	header Cache-Control "no-cache"
	file_server
}

:8004 {
	root * 04-reducir-peticiones
	header Cache-Control "no-cache"
	file_server
}

:8005 {
	root * 05-compresion-cache/dist
	import 05-compresion-cache/caddy-optimizado.conf
}

:8006 {
	root * 06-bonus-medicion/dist
	import 06-bonus-medicion/caddy-optimizado.conf
}
